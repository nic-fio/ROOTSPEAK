#!/bin/bash
# AMS - Advanced Messaging System for linux
# ams: invio e gestione dei messaggi. Riservato agli amministratori (gruppo admin).
set -euo pipefail

AMS_LIB=${AMS_LIB:-/usr/local/lib/ams}
[ -r "$AMS_LIB/ams-common.sh" ] || AMS_LIB=$(dirname "$(readlink -f "$0")")/../lib
. "$AMS_LIB/ams-common.sh"

# Da amministratore non root, ams si rilancia con sudo.
# AMS_TEST=1 permette di provarlo senza root su una cartella di prova.
if [ "$(id -u)" -ne 0 ] && [ -z "${AMS_TEST:-}" ]; then
	exec sudo -- "$(readlink -f "$0")" "$@"
fi

is_root() { [ "$(id -u)" -eq 0 ]; }

# Anche la guida e la versione girano solo come root, come ogni comando.
case ${1:-} in
'' | help | -h | --help)
	. "$AMS_LIB/ams-help.sh"
	ams_help
	exit 0
	;;
version | --version)
	echo "AMS - Advanced Messaging System for linux $AMS_VERSION"
	exit 0
	;;
esac

# Ogni accesso alle cartelle degli utenti avviene con l'identità dell'utente:
# così root non segue link simbolici preparati dall'utente.
as_user() {
	local u=$1
	shift
	if is_root; then runuser -u "$u" -- "$@"; else "$@"; fi
}

# ---- destinatari ----

human_users() {
	local min max
	min=$(awk '$1 == "UID_MIN" { print $2 }' /etc/login.defs 2>/dev/null)
	max=$(awk '$1 == "UID_MAX" { print $2 }' /etc/login.defs 2>/dev/null)
	getent passwd | awk -F: -v min="${min:-1000}" -v max="${max:-60000}" \
		'$3 >= min && $3 <= max && $7 !~ /(nologin|false)$/ { print $1 }'
}

online_users() {
	loginctl list-sessions --no-legend | awk '$6 == "user" { print $3 }'
}

group_members() {
	local line gid
	line=$(getent group "$1") || ams_die "gruppo inesistente: $1"
	gid=$(cut -d: -f3 <<<"$line")
	cut -d: -f4 <<<"$line" | tr ',' '\n'
	getent passwd | awk -F: -v gid="$gid" '$4 == gid { print $1 }'
}

resolve_recipients() {
	local item
	local -a items
	IFS=, read -ra items <<<"$1"
	for item in "${items[@]}"; do
		case $item in
		all) human_users ;;
		online) online_users ;;
		@*) group_members "${item#@}" ;;
		'') ;;
		*) getent passwd "$item" >/dev/null || ams_die "utente inesistente: $item"
		   echo "$item" ;;
		esac
	done | sed '/^$/d' | sort -u
}

# ---- sessioni ----

# Sessioni utente di logind: "id tipo tty"
user_sessions() {
	local s
	for s in $(loginctl list-sessions --no-legend | awk -v u="$1" '$3 == u && $6 == "user" { print $1 }'); do
		echo "$s $(loginctl show-session "$s" -p Type --value) $(loginctl show-session "$s" -p TTY --value)"
	done
}

# Terminali dell'utente: tutte le pts di sua proprietà (ssh, emulatori di
# terminale, tmux) più le console delle sessioni testuali. Le sessioni senza
# terminale (scp, cron, ssh senza pty) non ne hanno e restano escluse.
user_terminals() {
	local s type tty
	if [ -n "${AMS_TEST:-}" ]; then echo "${AMS_TEST_TTY:-}"; return; fi
	find /dev/pts -maxdepth 1 -user "$1" -name '[0-9]*' 2>/dev/null
	while read -r s type tty; do
		if [ "$type" = tty ] && [[ $tty == tty[0-9]* ]]; then echo "/dev/$tty"; fi
	done < <(user_sessions "$1")
}

has_graphical_session() {
	user_sessions "$1" | awk '$2 == "x11" || $2 == "wayland" { found = 1 } END { exit !found }'
}

# Riga di comando esatta dell'agente, per non confondere altri processi.
AGENT_RE="^/bin/bash $AMS_LIB/ams-user agent\$"

# Sveglia l'agente del desktop, così la finestra compare subito; se l'utente ha
# una sessione grafica ma nessun agente (per esempio perché era già collegato
# quando AMS è stato installato), lo avvia.
wake_agent() {
	local u=$1
	[ -z "${AMS_TEST:-}" ] || return 0
	has_graphical_session "$u" || return 0
	# Il segnale parte con l'identità dell'utente: raggiunge solo i suoi processi.
	as_user "$u" pkill -USR1 -u "$u" -f "$AGENT_RE" && return 0
	if is_root; then
		systemd-run --user --machine="$u@.host" --collect --quiet "$AMS_LIB/ams-user" agent || true
	else
		systemd-run --user --collect --quiet "$AMS_LIB/ams-user" agent || true
	fi
}

# ---- archivio ----

init_var() {
	install -d -m 755 "$AMS_VAR" "$AMS_VAR/users"
	install -d -m 700 "$AMS_VAR/sent"
}

user_dir() {
	local d=$AMS_VAR/users/$1
	if [ ! -d "$d" ]; then
		install -d -m 700 "$d"
		if is_root; then chown "$1:" "$d"; fi
	fi
	as_user "$1" mkdir -p "$d/inbox" "$d/read" "$d/acks" "$d/state"
}

next_id() {
	local seq=$AMS_VAR/sent/.seq n
	exec 8>"$seq.lock"
	flock 8
	n=$(($(cat "$seq" 2>/dev/null || echo 0) + 1))
	echo "$n" >"$seq"
	exec 8>&-
	echo "$n"
}

# Vero se il destinatario U ha già la sua copia del messaggio ID.
delivered() {
	awk -v u="$1" '$1 == u { f = 1 } END { exit !f }' "$AMS_VAR/sent/$2/delivery" 2>/dev/null
}

# Scrive la copia del messaggio ID nella casella di U e verifica che ci sia.
# Non la riscrive se U l'ha già letta o confermata. Esito 1 se la copia manca.
deliver_copy() {
	local u=$1 id=$2 d=$AMS_VAR/users/$1
	user_dir "$u" 2>/dev/null || return 1
	if as_user "$u" test -e "$d/read/$id" -o -e "$d/acks/$id" 2>/dev/null; then
		return 0
	fi
	as_user "$u" sh -c 'cat >"$1.tmp" && mv "$1.tmp" "$1"' _ "$d/inbox/$id" <"$AMS_VAR/sent/$id/msg" 2>/dev/null &&
		as_user "$u" test -s "$d/inbox/$id" 2>/dev/null
}

# Completa gli invii rimasti a metà (sent/ID/incomplete): gira all'avvio di
# ogni comando. Un invio interrotto prima di aver salvato messaggio e
# destinatari viene annullato (sent/ID/failed).
recover() {
	local f dir id u miss n
	[ -d "$AMS_VAR/sent" ] || return 0
	for f in "$AMS_VAR"/sent/*/incomplete; do
		[ -e "$f" ] || continue
		dir=${f%/incomplete}
		id=${dir##*/}
		# Un invio ancora in corso tiene il lock: non è interrotto, si salta.
		exec 6>"$dir/lock"
		if ! flock -n 6; then
			exec 6>&-
			continue
		fi
		if [ ! -e "$f" ]; then
			exec 6>&-
			continue
		fi
		if [ ! -s "$dir/msg" ] || [ ! -s "$dir/recipients" ]; then
			date +%s >"$dir/failed"
			rm -f "$f"
			ams_log "messaggio $id: invio interrotto prima del salvataggio, annullato"
			echo "ams: il messaggio $id era stato interrotto prima di essere salvato ed è stato annullato" >&2
			exec 6>&-
			continue
		fi
		if [ -e "$dir/revoked" ] || ams_msg_expired "$dir/msg"; then
			rm -f "$f"
			exec 6>&-
			continue
		fi
		miss=0 n=0
		for u in $(cat "$dir/recipients"); do
			delivered "$u" "$id" && continue
			if deliver_copy "$u" "$id"; then
				echo "$u $(date +%s) 0" >>"$dir/delivery"
				wake_agent "$u"
				n=$((n + 1))
			else
				miss=$((miss + 1))
			fi
		done
		if [ $miss -eq 0 ]; then rm -f "$f"; fi
		if [ $n -gt 0 ]; then
			ams_log "messaggio $id: consegna completata per $n destinatari dopo un'interruzione"
			echo "ams: completata la consegna del messaggio $id a $n destinatari" >&2
		fi
		if [ $miss -gt 0 ]; then
			echo "ams: messaggio $id ancora non consegnato a $miss destinatari (vedi ams status $id)" >&2
		fi
		exec 6>&-
	done
}

sent_msg() {
	local f=$AMS_VAR/sent/$1/msg
	[[ $1 =~ ^[0-9]+$ ]] && [ -f "$f" ] || ams_die "messaggio inesistente: $1"
	echo "$f"
}

parse_expires() {
	local n=${1%[mhd]}
	case $1 in
	*[0-9]m) echo $(($(date +%s) + n * 60)) ;;
	*[0-9]h) echo $(($(date +%s) + n * 3600)) ;;
	*[0-9]d) echo $(($(date +%s) + n * 86400)) ;;
	*) date -d "$1" +%s 2>/dev/null || ams_die "scadenza non valida: $1" ;;
	esac
}

check_expires() {
	[ "$1" -gt "$(date +%s)" ] || ams_die "la scadenza è già passata"
	echo "$1"
}

# ---- comandi ----

cmd_send() {
	local to='' title='' expires='' file='' text id dir msg u t
	local nterm users n failed
	while [ $# -gt 0 ]; do
		case $1 in
		--to) to=${2:?}; shift 2 ;;
		--title) title=${2:?}; shift 2 ;;
		--expires) expires=$(parse_expires "${2:?}"); expires=$(check_expires "$expires"); shift 2 ;;
		--file) file=${2:?}; shift 2 ;;
		--) shift; break ;;
		-*) ams_die "opzione sconosciuta: $1" ;;
		*) break ;;
		esac
	done
	[ -n "$to" ] || ams_die "manca --to"

	if [ $# -gt 0 ]; then text="$*"
	elif [ -n "$file" ]; then text=$(cat -- "$file")
	else text=$(cat)
	fi
	text=$(ams_sanitize <<<"$text")
	title=$(printf '%s' "$title" | ams_sanitize | tr '\n\t' '  ')
	[ -n "${text//[[:space:]]/}" ] || ams_die "messaggio vuoto"

	users=$(resolve_recipients "$to")
	[ -n "$users" ] || ams_die "nessun destinatario"

	init_var
	id=$(next_id)
	dir=$AMS_VAR/sent/$id
	mkdir -m 700 "$dir"
	# Il lock dice «invio in corso» a recover per tutta la consegna; se ams
	# send muore, anche con SIGKILL, il kernel lo rilascia.
	exec 7>"$dir/lock"
	flock 7
	# Il segno resta finché tutte le copie non sono consegnate: se l'invio si
	# interrompe, il comando ams successivo lo completa (recover).
	: >"$dir/incomplete"
	msg=$dir/msg
	{
		echo "id: $id"
		echo "from: ${SUDO_USER:-$(id -un)}"
		echo "date: $(date +%s)"
		echo "title: $title"
		echo "expires: $expires"
		echo
		printf '%s\n' "$text"
	} >"$msg.tmp"
	mv "$msg.tmp" "$msg"
	echo "$users" >"$dir/recipients.tmp"
	mv "$dir/recipients.tmp" "$dir/recipients"

	failed=''
	for u in $users; do
		if ! deliver_copy "$u" "$id"; then
			failed+=" $u"
			ams_log "messaggio $id: ERRORE, copia per $u non scritta"
			continue
		fi

		nterm=0
		for t in $(user_terminals "$u"); do
			if ams_msg_term "$msg" | sed 's/$/\r/' | timeout 3 tee "$t" >/dev/null 2>&1; then
				nterm=$((nterm + 1))
			fi
		done
		wake_agent "$u"
		echo "$u $(date +%s) $nterm" >>"$dir/delivery"
	done

	ams_log "messaggio $id inviato da ${SUDO_USER:-$(id -un)} a: $(echo $users)"
	n=$(wc -w <<<"$users")
	if [ -n "$failed" ]; then
		echo "Messaggio $id consegnato a $((n - $(wc -w <<<"$failed"))) destinatari su $n."
		ams_die "messaggio $id non consegnato a:$failed (vedi il registro; il prossimo comando ams riproverà)"
	fi
	rm -f "$dir/incomplete"
	if [ "$n" -eq 1 ]; then echo "Messaggio $id inviato a 1 utente."; else echo "Messaggio $id inviato a $n utenti."; fi
}

# Stato di un destinatario, uno dei tre: "inviato" (la copia non è ancora nella
# casella), "consegnato" (è nella casella), "confermato EPOCH CANALE".
recipient_state() {
	local u=$1 id=$2 d=$AMS_VAR/users/$1 ack epoch channel
	if ! delivered "$u" "$id"; then
		echo inviato
		return
	fi
	ack=$(as_user "$u" cat "$d/acks/$id" 2>/dev/null | head -c 200 | ams_sanitize) || true
	if [ -n "$ack" ]; then
		read -r epoch channel <<<"$ack"
		[[ $epoch =~ ^[0-9]+$ ]] || epoch=0
		echo "confermato $epoch ${channel:-?}"
	else
		echo consegnato
	fi
}

# Ora dell'ultimo rinvio del messaggio da parte di U (vuoto se non l'ha rimandato).
snoozed_at() {
	local d=$AMS_VAR/users/$1/state t
	t=$(as_user "$1" sh -c 'stat -c %Y "$1".term "$1".gui 2>/dev/null' _ "$d/$2" | sort -n | tail -1) || true
	if [[ $t =~ ^[0-9]+$ ]]; then date -d "@$t" '+%d/%m %H:%M'; fi
}

cmd_list() {
	local dir id msg n tot state flag u nd
	[ -d "$AMS_VAR/sent" ] || { echo "Nessun messaggio inviato."; return; }
	printf '%-5s %-12s %-9s %s\n' ID DATA CONFERME TESTO
	for dir in $(find "$AMS_VAR/sent" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' | sort -n); do
		msg=$AMS_VAR/sent/$dir/msg
		id=$dir
		n=0 tot=0 nd=0
		if [ -e "$AMS_VAR/sent/$id/failed" ]; then
			printf '%-5s %-12s %-9s %s\n' "$id" "-" "-" "[invio annullato: interrotto prima del salvataggio]"
			continue
		fi
		for u in $(cat "$AMS_VAR/sent/$id/recipients"); do
			tot=$((tot + 1))
			state=$(recipient_state "$u" "$id")
			case $state in
			confermato*) n=$((n + 1)) ;;
			inviato) nd=$((nd + 1)) ;;
			esac
		done
		flag=''
		[ $nd -gt 0 ] && flag="[$nd non consegnati] "
		[ -e "$AMS_VAR/sent/$id/revoked" ] && flag+='[ritirato] '
		ams_msg_expired "$msg" && flag+='[scaduto] '
		printf '%-5s %-12s %-9s %s\n' "$id" "$(date -d "@$(ams_msg_get "$msg" date)" '+%d/%m %H:%M')" \
			"$n/$tot" "$flag$(ams_msg_body "$msg" | head -1 | cut -c1-50)"
	done
}

cmd_status() {
	local id=${1:?manca l\'ID del messaggio} msg u state epoch channel line when nterm
	msg=$(sent_msg "$id")
	[ -e "$AMS_VAR/sent/$id/failed" ] && ams_die "il messaggio $id è stato annullato: l'invio si era interrotto prima del salvataggio"
	echo "Messaggio $id · $(ams_msg_heading "$msg") · da $(ams_msg_get "$msg" from)"
	[ -e "$AMS_VAR/sent/$id/revoked" ] && echo "RITIRATO il $(date -d "@$(cat "$AMS_VAR/sent/$id/revoked")" '+%d/%m %H:%M')"
	ams_msg_expired "$msg" && echo "SCADUTO"
	ams_msg_body "$msg" | sed 's/^/  │ /'
	echo
	printf '%-16s %s\n' UTENTE STATO
	for u in $(cat "$AMS_VAR/sent/$id/recipients"); do
		state=$(recipient_state "$u" "$id")
		case $state in
		confermato*)
			read -r _ epoch channel <<<"$state"
			line="confermato il $(date -d "@$epoch" '+%d/%m %H:%M') ($channel)" ;;
		inviato)
			if [ -e "$AMS_VAR/sent/$id/incomplete" ]; then
				line="inviato, non consegnato: la copia non è stata scritta (vedi il registro; il prossimo comando ams riproverà)"
			else
				line="inviato, non consegnato"
			fi ;;
		*)
			line="consegnato"
			if [ -e "$AMS_VAR/sent/$id/revoked" ]; then line+=", non confermato (ritirato)"
			elif ams_msg_expired "$msg"; then line+=", non confermato (scaduto)"
			else
				nterm=$(awk -v u="$u" '$1 == u { print $3 }' "$AMS_VAR/sent/$id/delivery" 2>/dev/null)
				when=$(snoozed_at "$u" "$id")
				case ${nterm:-0} in
				0) ;;
				1) line+=", scritto su 1 terminale" ;;
				*) line+=", scritto su $nterm terminali" ;;
				esac
				if [ -n "$when" ]; then line+=", rimandato il $when"; fi
			fi ;;
		esac
		printf '%-16s %s\n' "$u" "$line"
	done
}

cmd_revoke() {
	local id=${1:?manca l\'ID del messaggio} u
	sent_msg "$id" >/dev/null
	date +%s >"$AMS_VAR/sent/$id/revoked"
	for u in $(cat "$AMS_VAR/sent/$id/recipients"); do
		as_user "$u" rm -f "$AMS_VAR/users/$u/inbox/$id" "$AMS_VAR/users/$u/state/$id".* 2>/dev/null || true
	done
	ams_log "messaggio $id ritirato da ${SUDO_USER:-$(id -un)}"
	echo "Messaggio $id ritirato."
}

case ${1:-} in
send | list | status | revoke) recover ;;
esac

case ${1:-} in
send) shift; cmd_send "$@" ;;
list) shift; cmd_list ;;
status) shift; cmd_status "$@" ;;
revoke) shift; cmd_revoke "$@" ;;
*) ams_die "comando sconosciuto: $1 (ams --help per la guida)" ;;
esac
