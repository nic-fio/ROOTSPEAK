#!/bin/bash
# AMS - Advanced Messaging System for linux
# ams: invio e gestione dei messaggi. Riservato agli amministratori (gruppo admin).
set -euo pipefail

AMS_LIB=${AMS_LIB:-/usr/local/lib/ams}
[ -r "$AMS_LIB/ams-common.sh" ] || AMS_LIB=$(dirname "$(readlink -f "$0")")/../lib
. "$AMS_LIB/ams-common.sh"

# Da amministratore non root, ams si rilancia con sudo.
# AMS_TEST=1 permette di provarlo senza root su una cartella di prova.
if [ "$(id -u)" -ne 0 ] && [ -z "${AMS_TEST:-}" ]; then
	exec sudo -- "$(readlink -f "$0")" "$@"
fi

is_root() { [ "$(id -u)" -eq 0 ]; }

# Anche la guida e la versione girano solo come root, come ogni comando.
case ${1:-} in
'' | help | -h | --help)
	. "$AMS_LIB/ams-help.sh"
	ams_help
	exit 0
	;;
version | --version)
	echo "AMS - Advanced Messaging System for linux $AMS_VERSION"
	exit 0
	;;
esac

# Ogni accesso alle cartelle degli utenti avviene con l'identità dell'utente:
# così root non segue link simbolici preparati dall'utente.
as_user() {
	local u=$1
	shift
	if is_root; then runuser -u "$u" -- "$@"; else "$@"; fi
}

# ---- destinatari ----

human_users() {
	local min max
	min=$(awk '$1 == "UID_MIN" { print $2 }' /etc/login.defs 2>/dev/null)
	max=$(awk '$1 == "UID_MAX" { print $2 }' /etc/login.defs 2>/dev/null)
	getent passwd | awk -F: -v min="${min:-1000}" -v max="${max:-60000}" \
		'$3 >= min && $3 <= max && $7 !~ /(nologin|false)$/ { print $1 }'
}

# Gli utenti di human_users con almeno una sessione aperta: root e gli account
# di sistema restano esclusi anche quando sono collegati.
online_users() {
	local umani
	umani=$(human_users)
	loginctl list-sessions --no-legend | awk '$6 == "user" { print $3 }' | sort -u | grep -Fx -f <(echo "$umani") || true
}

group_members() {
	local line gid
	line=$(getent group "$1") || ams_die "$(t err_group "$1")"
	gid=$(cut -d: -f3 <<<"$line")
	cut -d: -f4 <<<"$line" | tr ',' '\n'
	getent passwd | awk -F: -v gid="$gid" '$4 == gid { print $1 }'
}

resolve_recipients() {
	local item
	local -a items
	IFS=, read -ra items <<<"$1"
	for item in "${items[@]}"; do
		case $item in
		all) human_users ;;
		online) online_users ;;
		@*) group_members "${item#@}" ;;
		'') ;;
		*) getent passwd "$item" >/dev/null || ams_die "$(t err_user "$item")"
		   echo "$item" ;;
		esac
	done | sed '/^$/d' | sort -u
}

# ---- sessioni ----

# Sessioni utente di logind: "id tipo tty"
user_sessions() {
	local s
	for s in $(loginctl list-sessions --no-legend | awk -v u="$1" '$3 == u && $6 == "user" { print $1 }'); do
		echo "$s $(loginctl show-session "$s" -p Type --value) $(loginctl show-session "$s" -p TTY --value)"
	done
}

# Terminali dell'utente: tutte le pts di sua proprietà (ssh, emulatori di
# terminale, tmux) più le console delle sessioni testuali. Le sessioni senza
# terminale (scp, cron, ssh senza pty) non ne hanno e restano escluse.
user_terminals() {
	local s type tty
	if [ -n "${AMS_TEST:-}" ]; then echo "${AMS_TEST_TTY:-}"; return; fi
	find /dev/pts -maxdepth 1 -user "$1" -name '[0-9]*' 2>/dev/null
	while read -r s type tty; do
		if [ "$type" = tty ] && [[ $tty == tty[0-9]* ]]; then echo "/dev/$tty"; fi
	done < <(user_sessions "$1")
}

# Lingua di chi usa il terminale T dell'utente U, in _LINGUA: quella del primo
# processo del terminale (di solito la shell). Se root non può leggerne
# l'ambiente (per esempio senza CAP_SYS_PTRACE in un container), lo legge
# l'utente stesso. Senza processi leggibili, quella del sistema.
term_lang() {
	local pid
	if [ -n "${AMS_TEST:-}" ]; then _LINGUA=$AMS_LINGUA; return 0; fi
	for pid in $(ps -o pid= -t "${1#/dev/}" 2>/dev/null); do
		ams_env_lang <"/proc/$pid/environ" 2>/dev/null && return 0
		ams_env_lang < <(as_user "$2" cat "/proc/$pid/environ" 2>/dev/null) && return 0
	done
	ams_sys_lang
	_LINGUA=$AMS_LINGUA_SISTEMA
}

# Scrive su stdin nel terminale T solo se, una volta aperto, appartiene ancora a
# U. Il nome /dev/pts/N non identifica una sessione: fra la ricerca dei
# terminali e la scrittura quello di U può chiudersi e lo stesso numero
# passare a un altro utente. Si apre il terminale e si controlla il
# proprietario del terminale aperto (/dev/fd/5), non del nome: se il numero
# viene riassegnato dopo l'apertura, la scrittura va al terminale vecchio, già
# chiuso, e fallisce.
write_term() {
	local t=$1 u=$2
	(
		exec 5>"$t" || exit 1
		[ -c /dev/fd/5 ] || [ -n "${AMS_TEST:-}" ] || exit 1
		[ "$(stat -L -c %U /dev/fd/5)" = "$u" ] || exit 1
		timeout 3 cat >&5
	) 2>/dev/null
}

has_graphical_session() {
	user_sessions "$1" | awk '$2 == "x11" || $2 == "wayland" { found = 1 } END { exit !found }'
}

# Riga di comando esatta dell'agente, per non confondere altri processi.
AGENT_RE="^/bin/bash $AMS_LIB/ams-user agent\$"

# Sveglia l'agente del desktop, così la finestra compare subito; se l'utente ha
# una sessione grafica ma nessun agente (per esempio perché era già collegato
# quando AMS è stato installato), lo avvia.
wake_agent() {
	local u=$1
	[ -z "${AMS_TEST:-}" ] || return 0
	has_graphical_session "$u" || return 0
	# Il segnale va solo all'agente pronto (PID in ams-agent.pronto) e solo se la
	# sua riga di comando è quella dell'agente; parte con l'identità dell'utente,
	# quindi non può raggiungere processi d'altri. Se non c'è un agente pronto se
	# ne avvia uno: se uno stava partendo, il nuovo esce (lock) e quello che
	# partiva legge comunque la casella al primo giro.
	local pronto
	pronto=/run/user/$(id -u "$u")/ams-agent.pronto
	as_user "$u" pkill -USR1 -u "$u" -F "$pronto" -f "$AGENT_RE" 2>/dev/null && return 0
	if is_root; then
		systemd-run --user --machine="$u@.host" --collect --quiet "$AMS_LIB/ams-user" agent || true
	else
		systemd-run --user --collect --quiet "$AMS_LIB/ams-user" agent || true
	fi
}

# ---- archivio ----

init_var() {
	install -d -m 755 "$AMS_VAR" "$AMS_VAR/users"
	install -d -m 700 "$AMS_VAR/sent"
}

user_dir() {
	local d=$AMS_VAR/users/$1
	[ -d "$d" ] || install -d -m 700 "$d"
	# Ancora di root: un invio interrotto fra la creazione e il chown. In
	# users/ scrive solo root, quindi la cartella è sua e si può sistemare.
	if is_root && [ ! -L "$d" ] && [ -O "$d" ]; then chown "$1:" "$d"; fi
	as_user "$1" mkdir -p "$d/inbox" "$d/read" "$d/acks" "$d/state"
}

next_id() {
	local seq=$AMS_VAR/sent/.seq n
	exec 8>"$seq.lock"
	flock 8
	n=$(($(cat "$seq" 2>/dev/null || echo 0) + 1))
	echo "$n" >"$seq"
	exec 8>&-
	echo "$n"
}

# Vero se il destinatario U ha già la sua copia del messaggio ID.
delivered() {
	awk -v u="$1" '$1 == u { f = 1 } END { exit !f }' "$AMS_VAR/sent/$2/delivery" 2>/dev/null
}

# Scrive la copia del messaggio ID nella casella di U e verifica che ci sia.
# Non la riscrive se U l'ha già letta o confermata. Esito 1 se la copia manca.
deliver_copy() {
	local u=$1 id=$2 d=$AMS_VAR/users/$1
	user_dir "$u" 2>/dev/null || return 1
	if as_user "$u" test -e "$d/read/$id" -o -e "$d/acks/$id" 2>/dev/null; then
		return 0
	fi
	as_user "$u" sh -c 'cat >"$1.tmp" && mv "$1.tmp" "$1"' _ "$d/inbox/$id" <"$AMS_VAR/sent/$id/msg" 2>/dev/null &&
		as_user "$u" test -s "$d/inbox/$id" 2>/dev/null
}

# Completa gli invii rimasti a metà (sent/ID/incomplete): gira all'avvio di
# ogni comando. Un invio interrotto prima di aver salvato messaggio e
# destinatari viene annullato (sent/ID/failed).
recover() {
	local f dir id u miss n
	[ -d "$AMS_VAR/sent" ] || return 0
	for f in "$AMS_VAR"/sent/*/incomplete; do
		[ -e "$f" ] || continue
		dir=${f%/incomplete}
		id=${dir##*/}
		# Un invio ancora in corso tiene il lock: non è interrotto, si salta.
		exec 6>"$dir/lock"
		if ! flock -n 6; then
			exec 6>&-
			continue
		fi
		if [ ! -e "$f" ]; then
			exec 6>&-
			continue
		fi
		if [ ! -s "$dir/msg" ] || [ ! -s "$dir/recipients" ]; then
			date +%s >"$dir/failed"
			rm -f "$f"
			ams_event ANNULLATO "$id" "" ""
			echo "ams: $(t recover_cancelled "$id")" >&2
			exec 6>&-
			continue
		fi
		if [ -e "$dir/revoked" ] || ams_msg_expired "$dir/msg"; then
			rm -f "$f"
			exec 6>&-
			continue
		fi
		miss=0 n=0
		for u in $(cat "$dir/recipients"); do
			# Già annotata: dopo un'interruzione di corrente la copia potrebbe
			# non essere arrivata su disco, quindi si riscrive se manca.
			if delivered "$u" "$id"; then
				deliver_copy "$u" "$id" || miss=$((miss + 1))
				continue
			fi
			if deliver_copy "$u" "$id"; then
				echo "$u $(date +%s) 0" >>"$dir/delivery"
				ams_event CONSEGNATO "$id" "$u" ""
				wake_agent "$u"
				n=$((n + 1))
			else
				miss=$((miss + 1))
			fi
		done
		if [ $miss -eq 0 ]; then
			sync -f "$AMS_VAR/users" "$dir"
			rm -f "$f"
		fi
		if [ $n -gt 0 ]; then
			ams_event RECUPERATO "$id" "" "" "$n"
			echo "ams: $(t recover_done "$id" "$n")" >&2
		fi
		if [ $miss -gt 0 ]; then
			echo "ams: $(t recover_missing "$id" "$miss" "$id")" >&2
		fi
		exec 6>&-
	done
	# ritiri rimasti a metà (sent/ID/ritiro) e cancellazioni rimaste a metà (sent/.cancella-ID)
	for f in "$AMS_VAR"/sent/*/ritiro; do
		[ -e "$f" ] || continue
		dir=${f%/ritiro}
		exec 6>"$dir/lock"
		if flock -n 6; then withdraw_copies "${dir##*/}" || true; fi
		exec 6>&-
	done
	for dir in "$AMS_VAR"/sent/.cancella-*; do
		[ -d "$dir" ] || continue
		purge_dir "$dir"
	done
}

# Toglie dalle caselle le copie del messaggio ID e i rinvii, come ciascun
# utente. Il segno sent/ID/ritiro resta finché qualche copia non si è potuta
# togliere: il comando ams successivo riprova. Esito 1 se ne manca qualcuna.
withdraw_copies() {
	local id=$1 dir=$AMS_VAR/sent/$1 u miss=0
	for u in $(cat "$dir/recipients" 2>/dev/null); do
		[ -d "$AMS_VAR/users/$u" ] || continue
		as_user "$u" sh -c 'rm -f "$1/inbox/$2" "$1/state/$2".* && [ ! -e "$1/inbox/$2" ]' \
			_ "$AMS_VAR/users/$u" "$id" 2>/dev/null || miss=$((miss + 1))
	done
	if [ $miss -eq 0 ]; then
		rm -f "$dir/ritiro"
		return 0
	fi
	return 1
}

# Toglie dalle caselle copie, conferme e rinvii di un messaggio già spostato in
# sent/.cancella-ID, poi la sua cartella. Si può ripetere dopo un'interruzione.
purge_dir() {
	local dir=$1 id=${1##*/.cancella-} u
	for u in $(cat "$dir/recipients" 2>/dev/null); do
		[ -d "$AMS_VAR/users/$u" ] || continue
		as_user "$u" sh -c 'rm -f "$1/inbox/$2" "$1/read/$2" "$1/acks/$2" "$1/state/$2.term" "$1/state/$2.gui"' \
			_ "$AMS_VAR/users/$u" "$id" 2>/dev/null || true
	done
	rm -rf "$dir"
}

sent_msg() {
	local f=$AMS_VAR/sent/$1/msg
	[[ $1 =~ ^[0-9]+$ ]] && [ -f "$f" ] || ams_die "$(t err_msg "$1")"
	echo "$f"
}

parse_expires() {
	local n=${1%[mhd]}
	case $1 in
	*[0-9]m) echo $(($(date +%s) + n * 60)) ;;
	*[0-9]h) echo $(($(date +%s) + n * 3600)) ;;
	*[0-9]d) echo $(($(date +%s) + n * 86400)) ;;
	*) date -d "$1" +%s 2>/dev/null || ams_die "$(t err_expiry "$1")" ;;
	esac
}

check_expires() {
	[ "$1" -gt "$(date +%s)" ] || ams_die "$(t err_expiry_past)"
	echo "$1"
}

# ---- comandi ----

cmd_send() {
	local to='' title='' expires='' file='' text id dir msg u t
	local nterm users n failed
	while [ $# -gt 0 ]; do
		case $1 in
		--to | --title | --expires | --file) [ -n "${2:-}" ] || ams_die "$(t err_value "$1")" ;;
		esac
		case $1 in
		--to) to=$2; shift 2 ;;
		--title) title=$2; shift 2 ;;
		--expires) expires=$(parse_expires "$2"); expires=$(check_expires "$expires"); shift 2 ;;
		--file) file=$2; shift 2 ;;
		--) shift; break ;;
		-*) ams_die "$(t err_option "$1")" ;;
		*) break ;;
		esac
	done
	[ -n "$to" ] || ams_die "$(t err_no_to)"

	if [ $# -gt 0 ]; then text="$*"
	elif [ -n "$file" ]; then text=$(cat -- "$file")
	else text=$(cat)
	fi
	text=$(ams_sanitize <<<"$text")
	title=$(printf '%s' "$title" | ams_sanitize | tr '\n\t' '  ')
	[ -n "${text//[[:space:]]/}" ] || ams_die "$(t err_empty)"
	# La finestra del desktop riceve il testo come argomento di zenity, e Linux
	# non accetta un argomento oltre 128 KiB: il limite lascia margine.
	[ "$(printf '%s' "$text" | wc -c)" -le "$AMS_MAX_BYTES" ] ||
		ams_die "$(t err_too_long "$(printf '%s' "$text" | wc -c)" "$AMS_MAX_BYTES")"

	users=$(resolve_recipients "$to")
	[ -n "$users" ] || ams_die "$(t err_no_recipients)"

	init_var
	id=$(next_id)
	dir=$AMS_VAR/sent/$id
	mkdir -m 700 "$dir"
	# Il lock dice «invio in corso» a recover per tutta la consegna; se ams
	# send muore, anche con SIGKILL, il kernel lo rilascia.
	exec 7>"$dir/lock"
	flock 7
	# Il segno resta finché tutte le copie non sono consegnate: se l'invio si
	# interrompe, il comando ams successivo lo completa (recover).
	: >"$dir/incomplete"
	msg=$dir/msg
	{
		echo "format: 1"
		echo "id: $id"
		echo "from: ${SUDO_USER:-$(id -un)}"
		echo "date: $(date +%s)"
		echo "title: $title"
		echo "expires: $expires"
		echo
		printf '%s\n' "$text"
	} >"$msg.tmp"
	mv "$msg.tmp" "$msg"
	echo "$users" >"$dir/recipients.tmp"
	mv "$dir/recipients.tmp" "$dir/recipients"
	# Messaggio, destinatari e segno di invio incompleto sono su disco prima di
	# ogni consegna: dopo un'interruzione di corrente il recupero li ritrova.
	sync "$dir/msg" "$dir/recipients" "$dir/incomplete" "$dir" "$AMS_VAR/sent"

	failed=''
	for u in $users; do
		# ritirato durante l'invio (ams revoke aspetta il lock): non si consegna altro
		[ ! -e "$dir/revoked" ] || break
		if ! deliver_copy "$u" "$id"; then
			failed+=" $u"
			ams_event NON_CONSEGNATO "$id" "$u" ""
			continue
		fi

		nterm=0
		for t in $(user_terminals "$u"); do
			# nella lingua di chi usa quel terminale
			term_lang "$t" "$u"
			if ams_msg_term "$msg" "$_LINGUA" | sed 's/$/\r/' | write_term "$t" "$u"; then
				nterm=$((nterm + 1))
			fi
		done
		wake_agent "$u"
		echo "$u $(date +%s) $nterm" >>"$dir/delivery"
		ams_event CONSEGNATO "$id" "$u" "" "$nterm"
	done

	ams_event INVIATO "$id" "" "" "$(echo $users)" "${SUDO_USER:-$(id -un)}"
	n=$(wc -w <<<"$users")
	if [ -n "$failed" ]; then
		t send_partial "$id" "$((n - $(wc -w <<<"$failed")))" "$n"; echo
		ams_die "$(t send_failed "$id" "$failed")"
	fi
	# Le copie e le consegne vanno su disco prima di togliere il segno: finché
	# c'è, il recupero ricontrolla ogni copia (anche quelle già annotate).
	sync -f "$AMS_VAR/users" "$dir"
	rm -f "$dir/incomplete"
	sync "$dir"
	if [ -e "$dir/revoked" ]; then t send_revoked "$id"; echo; return 0; fi
	if [ "$n" -eq 1 ]; then t send_ok_1 "$id"; else t send_ok_n "$id" "$n"; fi
	echo
}

# Per list e status le caselle si leggono una volta per utente: un solo
# runuser restituisce tutte le conferme (prima riga, al massimo 200 byte) e le
# date dei rinvii, poi ripulite e controllate qui. Le consegne di un messaggio
# si leggono una volta. Tutto resta in memoria per il resto del comando.
declare -A _ACK=() _SNZ=() _UTENTE_LETTO=() _DEL=() _DEL_LETTO=() _REV=()

load_user() {
	local u=$1 riga tipo id resto
	[ -n "${_UTENTE_LETTO[$u]:-}" ] && return
	_UTENTE_LETTO[$u]=1
	# Si cercano solo i messaggi che esistono in sent/, non tutto ciò che c'è
	# nella casella: migliaia di file finti in acks/ non rallentano root. Il
	# tempo è comunque limitato: una casella anomala non blocca ams.
	[ -n "${_IDS+x}" ] || _IDS=$(find "$AMS_VAR/sent" -mindepth 1 -maxdepth 1 -type d -name '[0-9]*' -printf '%f\n' 2>/dev/null)
	while IFS= read -r riga; do
		tipo=${riga%% *}
		resto=${riga#* }
		id=${resto%% *}
		resto=${resto#"$id"}
		resto=${resto# }
		[[ $id =~ ^[0-9]+$ ]] || continue
		case $tipo in
		A) _ACK[$u:$id]=$resto ;;
		S) if [[ $resto =~ ^[0-9]+$ ]] && [ "$resto" -gt "${_SNZ[$u:$id]:-0}" ]; then _SNZ[$u:$id]=$resto; fi ;;
		esac
	done < <(printf '%s\n' "$_IDS" | as_user "$u" timeout 20 sh -c '
		cd "$1" 2>/dev/null || exit 0
		while read -r id; do
			[ -f "acks/$id" ] && printf "A %s %s\n" "$id" "$(head -c 200 "acks/$id" | head -n 1)"
			for f in "state/$id.term" "state/$id.gui"; do
				[ -f "$f" ] && printf "S %s %s\n" "$id" "$(stat -c %Y "$f")"
			done
		done
		exit 0' _ "$AMS_VAR/users/$u" 2>/dev/null | ams_sanitize)
}

load_delivery() {
	local id=$1 u _resto
	[ -n "${_DEL_LETTO[$id]:-}" ] && return
	_DEL_LETTO[$id]=1
	if [ -f "$AMS_VAR/sent/$id/revoked" ]; then
		read -r _REV[$id] <"$AMS_VAR/sent/$id/revoked" 2>/dev/null || true
	fi
	[ -f "$AMS_VAR/sent/$id/delivery" ] || return 0
	while read -r u _resto; do
		_DEL[$id:$u]=1
	done <"$AMS_VAR/sent/$id/delivery"
}

# Stato di un destinatario, in RSTATE (senza sottoprocessi, per non perdere
# quanto già letto): "inviato" (la copia non è ancora nella casella),
# "consegnato" (è nella casella), "consegnato tardiva" (conferma arrivata dopo
# la scadenza, quindi non valida), "confermato EPOCH CANALE".
recipient_state() {
	local u=$1 id=$2 ack epoch channel exp
	load_delivery "$id"
	if [ -z "${_DEL[$id:$u]:-}" ]; then
		RSTATE=inviato
		return
	fi
	load_user "$u"
	ack=${_ACK[$u:$id]:-}
	if [ -z "$ack" ]; then
		RSTATE=consegnato
		return
	fi
	read -r epoch channel <<<"$ack"
	[[ $epoch =~ ^[0-9]+$ ]] || epoch=0
	# La scadenza che conta è quella della copia di riferimento (sent/), che
	# l'utente non può toccare: una conferma arrivata dopo non vale.
	exp=$(ams_msg_get "$AMS_VAR/sent/$id/msg" expires)
	if [ -n "$exp" ] && [ "$epoch" -gt "$exp" ]; then
		RSTATE="consegnato tardiva"
		return
	fi
	# Lo stesso per il ritiro: vale la data di sent/ID/revoked; una conferma
	# dello stesso secondo o precedente resta valida, una successiva no.
	if [[ ${_REV[$id]:-} =~ ^[0-9]+$ ]] && [ "$epoch" -gt "${_REV[$id]}" ]; then
		RSTATE=consegnato
		return
	fi
	RSTATE="confermato $epoch ${channel:-?}"
}

cmd_list() {
	local dir id msg n tot state flag u nd _REVOKED _EXPIRED dest data primo
	tv _REVOKED list_revoked
	tv _EXPIRED list_expired
	[ -d "$AMS_VAR/sent" ] || { t list_none; echo; return; }
	printf '%-5s %-12s %-9s %s\n' "$(t col_id)" "$(t col_date)" "$(t col_acks)" "$(t col_text)"
	for dir in $(find "$AMS_VAR/sent" -mindepth 1 -maxdepth 1 -type d -name '[0-9]*' -printf '%f\n' | sort -n); do
		msg=$AMS_VAR/sent/$dir/msg
		id=$dir
		n=0 tot=0 nd=0
		if [ -e "$AMS_VAR/sent/$id/failed" ]; then
			printf '%-5s %-12s %-9s %s\n' "$id" "-" "-" "$(t list_cancelled)"
			continue
		fi
		# Tutto ciò che serve si legge prima: un messaggio cancellato nel
		# frattempo da ams purge sparisce dall'elenco invece di uscire a metà.
		dest=$(cat "$AMS_VAR/sent/$id/recipients" 2>/dev/null) || continue
		data=$(ams_msg_get "$msg" date 2>/dev/null) || continue
		[[ $data =~ ^[0-9]+$ ]] || continue
		primo=$(ams_msg_body "$msg" 2>/dev/null | head -1 | cut -c1-50)
		for u in $dest; do
			tot=$((tot + 1))
			recipient_state "$u" "$id"
			state=$RSTATE
			case $state in
			confermato*) n=$((n + 1)) ;;
			inviato) nd=$((nd + 1)) ;;
			esac
		done
		flag=''
		[ $nd -gt 0 ] && tv flag list_undelivered "$nd"
		[ -e "$AMS_VAR/sent/$id/revoked" ] && flag+=$_REVOKED
		ams_msg_expired "$msg" 2>/dev/null && flag+=$_EXPIRED
		printf '%-5s %-12s %-9s %s\n' "$id" "$(date -d "@$data" '+%d/%m %H:%M')" "$n/$tot" "$flag$primo"
	done
}

cmd_status() {
	local id=${1:-} msg u state epoch channel line when nterm x
	[ -n "$id" ] || ams_die "$(t err_no_id)"
	msg=$(sent_msg "$id")
	[ -e "$AMS_VAR/sent/$id/failed" ] && ams_die "$(t err_cancelled "$id")"
	t status_head "$id" "$(ams_msg_heading "$msg")" "$(ams_msg_get "$msg" from)"; echo
	[ -e "$AMS_VAR/sent/$id/revoked" ] && { t status_revoked "$(date -d "@$(cat "$AMS_VAR/sent/$id/revoked")" '+%d/%m %H:%M')"; echo; }
	ams_msg_expired "$msg" && { t status_expired; echo; }
	ams_msg_body "$msg" | sed 's/^/  │ /'
	echo
	printf '%-16s %s\n' "$(t col_user)" "$(t col_state)"
	for u in $(cat "$AMS_VAR/sent/$id/recipients"); do
		recipient_state "$u" "$id"
		state=$RSTATE
		case $state in
		confermato*)
			read -r _ epoch channel <<<"$state"
			tv line st_confirmed "$(date -d "@$epoch" '+%d/%m %H:%M')" "$(ams_channel "$AMS_LINGUA" "$channel")" ;;
		inviato)
			if [ -e "$AMS_VAR/sent/$id/incomplete" ]; then tv line st_sent_failed; else tv line st_sent; fi ;;
		*)
			tv line st_delivered
			if [ -e "$AMS_VAR/sent/$id/revoked" ]; then tv x st_nc_revoked; line+=$x
			elif [ "$state" = "consegnato tardiva" ]; then tv x st_nc_late; line+=$x
			elif ams_msg_expired "$msg"; then tv x st_nc_expired; line+=$x
			else
				nterm=$(awk -v u="$u" '$1 == u { print $3 }' "$AMS_VAR/sent/$id/delivery" 2>/dev/null)
				load_user "$u"
				when=''
				if [ -n "${_SNZ[$u:$id]:-}" ]; then when=$(date -d "@${_SNZ[$u:$id]}" '+%d/%m %H:%M'); fi
				case ${nterm:-0} in
				0) ;;
				1) tv x st_term_1; line+=$x ;;
				*) tv x st_term_n "$nterm"; line+=$x ;;
				esac
				if [ -n "$when" ]; then tv x st_snoozed "$when"; line+=$x; fi
			fi ;;
		esac
		printf '%-16s %s\n' "$u" "$line"
	done
}

# Cancella i messaggi inviati da più di DURATA, con copie, conferme e rinvii
# nelle caselle (tolti con l'identità dell'utente). Salta gli invii in corso o
# interrotti. Nel journal restano gli eventi e l'evento CANCELLATO.
cmd_purge() {
	local dur=${1:-} sec n dir id quando u
	[ -n "$dur" ] || ams_die "$(t err_no_duration)"
	n=${dur%[mhd]}
	case $dur in
	*[0-9]m) sec=$((n * 60)) ;;
	*[0-9]h) sec=$((n * 3600)) ;;
	*[0-9]d) sec=$((n * 86400)) ;;
	*) ams_die "$(t err_duration "$dur")" ;;
	esac
	local limite=$(($(date +%s) - sec)) tolti=0
	for dir in "$AMS_VAR"/sent/*/; do
		dir=${dir%/}
		id=${dir##*/}
		[[ $id =~ ^[0-9]+$ ]] || continue
		[ -e "$dir/incomplete" ] && continue
		quando=$(ams_msg_get "$dir/msg" date 2>/dev/null)
		[[ $quando =~ ^[0-9]+$ ]] || quando=$(stat -c %Y "$dir")
		[ "$quando" -lt "$limite" ] || continue
		exec 5>"$dir/lock"
		if ! flock -n 5; then
			exec 5>&-
			continue
		fi
		# Il messaggio sparisce in un colpo solo (rinomina): gli altri comandi
		# lo vedono intero o non lo vedono. La pulizia delle caselle segue, e
		# se si interrompe la completa il comando ams successivo.
		mv "$dir" "$AMS_VAR/sent/.cancella-$id"
		sync "$AMS_VAR/sent"
		exec 5>&-
		ams_event CANCELLATO "$id" "" "" "$dur" "${SUDO_USER:-$(id -un)}"
		purge_dir "$AMS_VAR/sent/.cancella-$id"
		tolti=$((tolti + 1))
	done
	if [ $tolti -eq 1 ]; then t purge_1 "$dur"; else t purge_n "$tolti" "$dur"; fi
	echo
}

# La storia di un messaggio dal journal: gli eventi con AMS_MESSAGGIO=ID dalla
# data dell'invio (un archivio azzerato riusa i numeri, il journal no). Ogni
# evento si riscrive dai campi AMS_* nella lingua di chi legge; un evento che
# non si sa riscrivere mostra il suo testo originale.
cmd_log() {
	local id=${1:-} msg dal riga k v quando ev u ch det aut testo uid atteso radm
	[ -n "$id" ] || ams_die "$(t err_no_id)"
	msg=$(sent_msg "$id")
	dal=$(( $(ams_msg_get "$msg" date) - 1 ))
	t log_head "$id" "$(ams_msg_heading "$msg")"; echo
	# Chi può scrivere un evento: root per quelli dell'amministratore, l'utente
	# destinatario per rinvii e conferme. Il journal registra _UID, l'utente che
	# ha scritto davvero: chiunque può scrivere nel journal un evento con i
	# campi AMS_*, e uno scritto dall'utente sbagliato viene segnalato.
	radm=0
	[ -z "${AMS_TEST:-}" ] || radm=$(id -u)
	evento() {
		[ -n "$quando" ] || return 0
		local riscritto avviso=''
		case $ev in
		RINVIATO | CONFERMATO | CONFERMA_FALLITA) atteso=$(id -u "$u" 2>/dev/null) || atteso=x ;;
		*) atteso=$radm ;;
		esac
		[ "$uid" = "$atteso" ] || tv avviso log_untrusted "${uid:-?}"
		riscritto=$(ams_event_text "$AMS_LINGUA" "$ev" "$id" "$u" "$ch" "$det" "$aut") || riscritto=$testo
		printf '%(%Y-%m-%d %H:%M:%S)T  %s%s\n' "$((quando / 1000000))" "$avviso" "$riscritto" | ams_sanitize
	}
	quando='' ev='' u='' ch='' det='' aut='' testo='' uid=''
	while IFS= read -r riga; do
		if [ -z "$riga" ]; then
			evento
			quando='' ev='' u='' ch='' det='' aut='' testo='' uid=''
			continue
		fi
		k=${riga%%=*} v=${riga#*=}
		case $k in
		__REALTIME_TIMESTAMP) quando=$v ;;
		AMS_EVENTO) ev=$v ;;
		AMS_UTENTE) u=$v ;;
		AMS_CANALE) ch=$v ;;
		AMS_DETTAGLI) det=$v ;;
		AMS_AUTORE) aut=$v ;;
		MESSAGE) testo=$v ;;
		_UID) uid=$v ;;
		esac
	# solo i campi di testo che servono: i campi binari del formato export
	# (per esempio _SELINUX_CONTEXT) spezzerebbero la lettura per righe
	done < <(journalctl --no-pager -q -o export --since "@$dal" \
		--output-fields=MESSAGE,AMS_EVENTO,AMS_UTENTE,AMS_CANALE,AMS_DETTAGLI,AMS_AUTORE,_UID \
		SYSLOG_IDENTIFIER=ams AMS_MESSAGGIO="$id" 2>/dev/null)
	evento
}

# Il ritiro avviene quando compare sent/ID/revoked (su disco): da lì nessuna
# nuova consegna e nessuna conferma successiva vale. Poi si aspetta l'invio
# eventualmente in corso (lock), che si ferma al destinatario successivo, e si
# tolgono le copie; sent/ID/ritiro resta finché non sono tolte tutte.
cmd_revoke() {
	local id=${1:-} dir
	[ -n "$id" ] || ams_die "$(t err_no_id)"
	sent_msg "$id" >/dev/null
	dir=$AMS_VAR/sent/$id
	: >"$dir/ritiro"
	if [ ! -e "$dir/revoked" ]; then
		date +%s >"$dir/revoked.tmp"
		mv "$dir/revoked.tmp" "$dir/revoked"
		sync "$dir/revoked" "$dir/ritiro" "$dir"
		ams_event RITIRATO "$id" "" "" "" "${SUDO_USER:-$(id -un)}"
	fi
	exec 5>"$dir/lock"
	flock 5
	if withdraw_copies "$id"; then
		t revoke_ok "$id"; echo
	else
		ams_die "$(t revoke_partial "$id")"
	fi
	exec 5>&-
}

case ${1:-} in
send | list | status | revoke | log) recover ;;
esac

case ${1:-} in
send) shift; cmd_send "$@" ;;
list) shift; cmd_list ;;
status) shift; cmd_status "$@" ;;
revoke) shift; cmd_revoke "$@" ;;
log) shift; cmd_log "$@" ;;
purge) shift; cmd_purge "$@" ;;
*) ams_die "$(t err_command "$1")" ;;
esac
