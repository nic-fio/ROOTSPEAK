# RootSpeak - Advanced Messaging System for Linux
# Test machine: a distribution with systemd running (logind, sshd), to test RootSpeak
# for real as root, with real users and sessions. It does not touch the host system.
# Debian 13 by default; any other with BASE (tests/distros/run.sh does it for each
# distribution of tests/distros/list). The preparation is in setup.sh.
# The system language is Italian on purpose: RootSpeak must speak English anyway.
#   podman build -t rootspeak-test -f tests/container/Containerfile tests/container
#   podman build -t NAME --build-arg BASE=IMAGE -f tests/container/Containerfile tests/container
ARG BASE=docker.io/library/debian:trixie
FROM ${BASE}
COPY setup.sh /usr/local/sbin/rootspeak-test-setup
RUN /usr/local/sbin/rootspeak-test-setup
CMD ["/usr/lib/systemd/systemd"]
