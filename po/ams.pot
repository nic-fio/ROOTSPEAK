#: src/guida.c:30
msgctxt "guida-comandi"
msgid ""
"send [options] [TEXT]¦Sends a message to the recipients given with --to. "
"Without TEXT or --file, the text is read from stdin."
msgstr ""

#: src/guida.c:31
msgctxt "guida-comandi"
msgid ""
"list¦Lists the messages sent, with how many recipients have confirmed each "
"one."
msgstr ""

#: src/guida.c:32
msgctxt "guida-comandi"
msgid ""
"status ID¦Shows the text of the message and the state of each recipient: "
"sent, delivered (in their mailbox) or confirmed, with date, time and channel."
msgstr ""

#: src/guida.c:33
msgctxt "guida-comandi"
msgid ""
"revoke ID¦Revokes a message: whoever has not seen it yet will not see it, "
"and dialogs and questions still open close by themselves."
msgstr ""

#: src/guida.c:34
msgctxt "guida-comandi"
msgid ""
"log ID¦Shows the history of the message from the system log: sending, "
"deliveries, postponements, confirmations and revocation, with date and time."
msgstr ""

#: src/guida.c:35
msgctxt "guida-comandi"
msgid ""
"purge DURATION¦Deletes the messages sent more than DURATION ago (for example "
"90d), with the copies and confirmations in the users' mailboxes; the events "
"stay in the system log."
msgstr ""

#: src/guida.c:36
msgctxt "guida-comandi"
msgid "version¦Shows the AMS version."
msgstr ""

#: src/guida.c:37
msgctxt "guida-comandi"
msgid ""
"help, --help, -h¦Shows this guide. «ams» without arguments opens it too."
msgstr ""

#: src/guida.c:41
msgctxt "guida-opzioni"
msgid ""
"--to DEST¦Recipients, separated by commas without spaces: a user (mario), a "
"Unix group (@developers), all (every human user) or online (only those "
"logged in now)."
msgstr ""

#: src/guida.c:42
msgctxt "guida-opzioni"
msgid ""
"--title TITLE¦Title shown in the message header and in the desktop dialog."
msgstr ""

#: src/guida.c:43
msgctxt "guida-opzioni"
msgid ""
"--expires DURATION¦Expiry, after which the message is no longer shown: 30m, "
"2h, 3d or a date and time (\"2026-10-04 12:00\")."
msgstr ""

#: src/guida.c:44
msgctxt "guida-opzioni"
msgid "--file FILE¦Reads the message text from FILE."
msgstr ""

#: src/guida.c:48
msgctxt "guida-esempi"
msgid ""
"ams send --to mario \"Your account expires on Friday.\"¦Message with read "
"confirmation to a single user."
msgstr ""

#: src/guida.c:49
msgctxt "guida-esempi"
msgid ""
"ams send --to @developers --title Maintenance --file notice.txt¦Text taken "
"from a file, with a title, to every member of the developers group."
msgstr ""

#: src/guida.c:50
msgctxt "guida-esempi"
msgid ""
"ams send --to online --expires 15m \"Reboot at 13:00.\"¦Urgent notice to "
"whoever is logged in now; after 15 minutes it is no longer shown or asked "
"about."
msgstr ""

#: src/guida.c:51
msgctxt "guida-esempi"
msgid ""
"ams send --to all --expires 3d \"New password policy.\"¦To every user; after "
"three days it stops being shown."
msgstr ""

#: src/guida.c:52
msgctxt "guida-esempi"
msgid "ams list¦Which messages were sent and how many confirmations they have."
msgstr ""

#: src/guida.c:53
msgctxt "guida-esempi"
msgid "ams status 12¦Who confirmed message 12, when and from where."
msgstr ""

#: src/guida.c:54
msgctxt "guida-esempi"
msgid ""
"ams log 12¦The history of message 12: sending, deliveries, postponements, "
"confirmations."
msgstr ""

#: src/guida.c:55
msgctxt "guida-esempi"
msgid ""
"ams purge 90d¦Deletes the messages older than 90 days, with copies and "
"confirmations."
msgstr ""

#: src/guida.c:56
msgctxt "guida-esempi"
msgid "ams revoke 12¦Revokes message 12."
msgstr ""

#: src/guida.c:60
msgctxt "guida-file"
msgid ""
"/etc/ams/ams.conf¦Configuration: minutes before a postponed message is asked "
"about again, check interval of the desktop agent."
msgstr ""

#: src/guida.c:61
msgctxt "guida-file"
msgid ""
"/var/lib/ams/¦The messages: sent/ (reference copies, root only) and users/"
"USER/ (each user's mailbox, readable only by them and by root)."
msgstr ""

#: src/guida.c:62
msgctxt "guida-file"
msgid ""
"sudo journalctl -t ams¦The system log: sending, deliveries, confirmations "
"and revocations."
msgstr ""

#: src/guida.c:63
msgctxt "guida-file"
msgid ""
"/usr/local/share/doc/ams/AMS_Manuale_Utente.html¦The complete user manual "
"(in Italian), to open in a browser."
msgstr ""

