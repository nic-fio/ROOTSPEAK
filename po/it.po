#: src/guida.c:30
msgctxt "guida-comandi"
msgid "send [options] [TEXT]¦Sends a message to the recipients given with --to. Without TEXT or --file, the text is read from stdin."
msgstr "send [opzioni] [TESTO]¦Invia un messaggio ai destinatari indicati con --to. Senza TESTO né --file, il testo viene letto da stdin."

#: src/guida.c:31
msgctxt "guida-comandi"
msgid "list¦Lists the messages sent, with how many recipients have confirmed each one."
msgstr "list¦Elenca i messaggi inviati, con quanti destinatari hanno confermato ciascun messaggio."

#: src/guida.c:32
msgctxt "guida-comandi"
msgid "status ID¦Shows the text of the message and the state of each recipient: sent, delivered (in their mailbox) or confirmed, with date, time and channel."
msgstr "status ID¦Mostra il testo del messaggio e lo stato di ogni destinatario: inviato, consegnato (nella sua casella) o confermato, con data, ora e canale."

#: src/guida.c:33
msgctxt "guida-comandi"
msgid "revoke ID¦Revokes a message: whoever has not seen it yet will not see it, and dialogs and questions still open close by themselves."
msgstr "revoke ID¦Ritira un messaggio: chi non l'ha ancora visto non lo vedrà più, e finestre e domande ancora aperte si chiudono da sole."

#: src/guida.c:34
msgctxt "guida-comandi"
msgid "log ID¦Shows the history of the message from the system log: sending, deliveries, postponements, confirmations and revocation, with date and time."
msgstr "log ID¦Mostra la storia del messaggio dal registro di sistema: invio, consegne, rinvii, conferme e ritiro, con data e ora."

#: src/guida.c:35
msgctxt "guida-comandi"
msgid "purge DURATION¦Deletes the messages sent more than DURATION ago (for example 90d), with the copies and confirmations in the users' mailboxes; the events stay in the system log."
msgstr "purge DURATA¦Cancella i messaggi inviati da più di DURATA (per esempio 90d), con le copie e le conferme nelle caselle degli utenti; gli eventi restano nel registro di sistema."

#: src/guida.c:36
msgctxt "guida-comandi"
msgid "version¦Shows the AMS version."
msgstr "version¦Mostra la versione di AMS."

#: src/guida.c:37
msgctxt "guida-comandi"
msgid "help, --help, -h¦Shows this guide. «ams» without arguments opens it too."
msgstr "help, --help, -h¦Mostra questa guida. La apre anche «ams» senza argomenti."

#: src/guida.c:41
msgctxt "guida-opzioni"
msgid "--to DEST¦Recipients, separated by commas without spaces: a user (mario), a Unix group (@developers), all (every human user) or online (only those logged in now)."
msgstr "--to DEST¦Destinatari, separati da virgole senza spazi: un utente (mario), un gruppo Unix (@sviluppo), all (tutti gli utenti umani) oppure online (solo quelli collegati adesso)."

#: src/guida.c:42
msgctxt "guida-opzioni"
msgid "--title TITLE¦Title shown in the message header and in the desktop dialog."
msgstr "--title TITOLO¦Titolo mostrato nell'intestazione del messaggio e nella finestra del desktop."

#: src/guida.c:43
msgctxt "guida-opzioni"
msgid "--expires DURATION¦Expiry, after which the message is no longer shown: 30m, 2h, 3d or a date and time (\"2026-10-04 12:00\")."
msgstr "--expires DURATA¦Scadenza, dopo la quale il messaggio non viene più mostrato: 30m, 2h, 3d oppure data e ora (\"2026-10-04 12:00\"; le date a parole vanno in inglese)."

#: src/guida.c:44
msgctxt "guida-opzioni"
msgid "--file FILE¦Reads the message text from FILE."
msgstr "--file FILE¦Legge il testo del messaggio da FILE."

#: src/guida.c:48
msgctxt "guida-esempi"
msgid "ams send --to mario \"Your account expires on Friday.\"¦Message with read confirmation to a single user."
msgstr "ams send --to mario \"Il tuo account scade venerdì.\"¦Messaggio con conferma di lettura a un solo utente."

#: src/guida.c:49
msgctxt "guida-esempi"
msgid "ams send --to @developers --title Maintenance --file notice.txt¦Text taken from a file, with a title, to every member of the developers group."
msgstr "ams send --to @sviluppo --title Manutenzione --file avviso.txt¦Testo preso da un file, con titolo, a tutti i membri del gruppo sviluppo."

#: src/guida.c:50
msgctxt "guida-esempi"
msgid "ams send --to online --expires 15m \"Reboot at 13:00.\"¦Urgent notice to whoever is logged in now; after 15 minutes it is no longer shown or asked about."
msgstr "ams send --to online --expires 15m \"Riavvio alle 13:00.\"¦Avviso urgente a chi è collegato adesso; dopo 15 minuti non viene più mostrato né sollecitato."

#: src/guida.c:51
msgctxt "guida-esempi"
msgid "ams send --to all --expires 3d \"New password policy.\"¦To every user; after three days it stops being shown."
msgstr "ams send --to all --expires 3d \"Nuova policy password.\"¦A tutti gli utenti; dopo tre giorni smette di essere mostrato."

#: src/guida.c:52
msgctxt "guida-esempi"
msgid "ams list¦Which messages were sent and how many confirmations they have."
msgstr "ams list¦Quali messaggi sono stati inviati e quante conferme hanno."

#: src/guida.c:53
msgctxt "guida-esempi"
msgid "ams status 12¦Who confirmed message 12, when and from where."
msgstr "ams status 12¦Chi ha confermato il messaggio 12, quando e da dove."

#: src/guida.c:54
msgctxt "guida-esempi"
msgid "ams log 12¦The history of message 12: sending, deliveries, postponements, confirmations."
msgstr "ams log 12¦La storia del messaggio 12: invio, consegne, rinvii, conferme."

#: src/guida.c:55
msgctxt "guida-esempi"
msgid "ams purge 90d¦Deletes the messages older than 90 days, with copies and confirmations."
msgstr "ams purge 90d¦Cancella i messaggi di più di 90 giorni fa, con copie e conferme."

#: src/guida.c:56
msgctxt "guida-esempi"
msgid "ams revoke 12¦Revokes message 12."
msgstr "ams revoke 12¦Ritira il messaggio 12."

#: src/guida.c:60
msgctxt "guida-file"
msgid "/etc/ams/ams.conf¦Configuration: minutes before a postponed message is asked about again, check interval of the desktop agent."
msgstr "/etc/ams/ams.conf¦Configurazione: minuti prima di riproporre un messaggio rimandato, intervallo di controllo dell'agente del desktop."

#: src/guida.c:61
msgctxt "guida-file"
msgid "/var/lib/ams/¦The messages: sent/ (reference copies, root only) and users/USER/ (each user's mailbox, readable only by them and by root)."
msgstr "/var/lib/ams/¦I messaggi: sent/ (copie di riferimento, solo root) e users/UTENTE/ (la casella di ogni utente, leggibile solo da lui e da root)."

#: src/guida.c:62
msgctxt "guida-file"
msgid "sudo journalctl -t ams¦The system log: sending, deliveries, confirmations and revocations."
msgstr "sudo journalctl -t ams¦Il registro di sistema: invii, consegne, conferme e ritiri."

#: src/guida.c:63
msgctxt "guida-file"
msgid "/usr/local/share/doc/ams/AMS_Manuale_Utente.html¦The complete user manual (in Italian), to open in a browser."
msgstr "/usr/local/share/doc/ams/AMS_Manuale_Utente.html¦Il manuale utente completo, da aprire in un browser."

