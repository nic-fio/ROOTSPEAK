#: src/guida.c:30
msgctxt "guida-comandi"
msgid ""
"(no command)¦In a terminal, opens the interactive interface: the messages "
"with their recipients and history; write and send, revoke, remind, delete "
"old messages. In a pipe, shows this guide."
msgstr ""
"(nessun comando)¦In un terminale apre l'interfaccia interattiva: i messaggi "
"con i loro destinatari e la loro storia; scrivere e inviare, ritirare, "
"sollecitare, cancellare i messaggi vecchi. In una pipe mostra questa guida."

#: src/guida.c:31
msgctxt "guida-comandi"
msgid ""
"send [options] [TEXT]¦Sends a message to the recipients given with --to. "
"Without TEXT or --file, the text is read from stdin."
msgstr ""
"send [opzioni] [TESTO]¦Invia un messaggio ai destinatari indicati con --to. "
"Senza TESTO né --file, il testo viene letto da stdin."

#: src/guida.c:32
msgctxt "guida-comandi"
msgid ""
"list¦Lists the messages sent, with how many recipients have confirmed each "
"one."
msgstr ""
"list¦Elenca i messaggi inviati, con quanti destinatari hanno confermato "
"ciascun messaggio."

#: src/guida.c:33
msgctxt "guida-comandi"
msgid ""
"status ID¦Shows the text of the message and the state of each recipient: "
"sent, delivered (in their mailbox) or confirmed, with date, time and channel."
msgstr ""
"status ID¦Mostra il testo del messaggio e lo stato di ogni destinatario: "
"inviato, consegnato (nella sua casella) o confermato, con data, ora e canale."

#: src/guida.c:34
msgctxt "guida-comandi"
msgid ""
"revoke ID¦Revokes a message: whoever has not seen it yet will not see it, "
"and dialogs and questions still open close by themselves."
msgstr ""
"revoke ID¦Ritira un messaggio: chi non l'ha ancora visto non lo vedrà più, e "
"finestre e domande ancora aperte si chiudono da sole."

#: src/guida.c:35
msgctxt "guida-comandi"
msgid ""
"remind ID¦Reminds whoever has not confirmed yet: the question comes back at "
"their next prompt and the dialog reappears on the desktop, even if they had "
"postponed it."
msgstr ""
"remind ID¦Sollecita chi non ha ancora confermato: la domanda torna al suo "
"prompt successivo e la finestra ricompare sul desktop, anche se l'aveva "
"rimandata."

#: src/guida.c:36
msgctxt "guida-comandi"
msgid ""
"log ID¦Shows the history of the message from the system log: sending, "
"deliveries, postponements, confirmations and revocation, with date and time."
msgstr ""
"log ID¦Mostra la storia del messaggio dal registro di sistema: invio, "
"consegne, rinvii, conferme e ritiro, con data e ora."

#: src/guida.c:37
msgctxt "guida-comandi"
msgid ""
"purge DURATION¦Deletes the messages sent more than DURATION ago (for example "
"90d), with the copies and confirmations in the users' mailboxes; the events "
"stay in the system log."
msgstr ""
"purge DURATA¦Cancella i messaggi inviati da più di DURATA (per esempio 90d), "
"con le copie e le conferme nelle caselle degli utenti; gli eventi restano "
"nel registro di sistema."

#: src/guida.c:38
msgctxt "guida-comandi"
msgid "version¦Shows the RootSpeak version."
msgstr "version¦Mostra la versione di RootSpeak."

#: src/guida.c:39
msgctxt "guida-comandi"
msgid "help, --help, -h¦Shows this guide."
msgstr "help, --help, -h¦Mostra questa guida."

#: src/guida.c:43
msgctxt "guida-opzioni"
msgid ""
"--to DEST¦Recipients, separated by commas without spaces: a user (mario), a "
"Unix group (@developers), all (every human user) or online (only those "
"logged in now)."
msgstr ""
"--to DEST¦Destinatari, separati da virgole senza spazi: un utente (mario), "
"un gruppo Unix (@sviluppo), all (tutti gli utenti umani) oppure online (solo "
"quelli collegati adesso)."

#: src/guida.c:44
msgctxt "guida-opzioni"
msgid ""
"--title TITLE¦Title shown in the message header and in the desktop dialog."
msgstr ""
"--title TITOLO¦Titolo mostrato nell'intestazione del messaggio e nella "
"finestra del desktop."

#: src/guida.c:45
msgctxt "guida-opzioni"
msgid ""
"--expires DURATION¦Expiry, after which the message is no longer shown: 30m, "
"2h, 3d or a date and time (\"2026-10-04 12:00\")."
msgstr ""
"--expires DURATA¦Scadenza, dopo la quale il messaggio non viene più "
"mostrato: 30m, 2h, 3d oppure data e ora (\"2026-10-04 12:00\"; le date a "
"parole vanno in inglese)."

#: src/guida.c:46
msgctxt "guida-opzioni"
msgid "--file FILE¦Reads the message text from FILE."
msgstr "--file FILE¦Legge il testo del messaggio da FILE."

#: src/guida.c:50
msgctxt "guida-esempi"
msgid ""
"rspeak send --to mario \"Your account expires on Friday.\"¦Message with read "
"confirmation to a single user."
msgstr ""
"rspeak send --to mario \"Il tuo account scade venerdì.\"¦Messaggio con "
"conferma di lettura a un solo utente."

#: src/guida.c:51
msgctxt "guida-esempi"
msgid ""
"rspeak send --to @developers --title Maintenance --file notice.txt¦Text "
"taken from a file, with a title, to every member of the developers group."
msgstr ""
"rspeak send --to @sviluppo --title Manutenzione --file avviso.txt¦Testo "
"preso da un file, con titolo, a tutti i membri del gruppo sviluppo."

#: src/guida.c:52
msgctxt "guida-esempi"
msgid ""
"rspeak send --to online --expires 15m \"Reboot at 13:00.\"¦Urgent notice to "
"whoever is logged in now; after 15 minutes it is no longer shown or asked "
"about."
msgstr ""
"rspeak send --to online --expires 15m \"Riavvio alle 13:00.\"¦Avviso urgente "
"a chi è collegato adesso; dopo 15 minuti non viene più mostrato né "
"sollecitato."

#: src/guida.c:53
msgctxt "guida-esempi"
msgid ""
"rspeak send --to all --expires 3d \"New password policy.\"¦To every user; "
"after three days it stops being shown."
msgstr ""
"rspeak send --to all --expires 3d \"Nuova policy password.\"¦A tutti gli "
"utenti; dopo tre giorni smette di essere mostrato."

#: src/guida.c:54
msgctxt "guida-esempi"
msgid ""
"rspeak list¦Which messages were sent and how many confirmations they have."
msgstr "rspeak list¦Quali messaggi sono stati inviati e quante conferme hanno."

#: src/guida.c:55
msgctxt "guida-esempi"
msgid "rspeak status 12¦Who confirmed message 12, when and from where."
msgstr "rspeak status 12¦Chi ha confermato il messaggio 12, quando e da dove."

#: src/guida.c:56
msgctxt "guida-esempi"
msgid ""
"rspeak log 12¦The history of message 12: sending, deliveries, postponements, "
"confirmations."
msgstr ""
"rspeak log 12¦La storia del messaggio 12: invio, consegne, rinvii, conferme."

#: src/guida.c:57
msgctxt "guida-esempi"
msgid ""
"rspeak purge 90d¦Deletes the messages older than 90 days, with copies and "
"confirmations."
msgstr ""
"rspeak purge 90d¦Cancella i messaggi di più di 90 giorni fa, con copie e "
"conferme."

#: src/guida.c:58
msgctxt "guida-esempi"
msgid "rspeak revoke 12¦Revokes message 12."
msgstr "rspeak revoke 12¦Ritira il messaggio 12."

#: src/guida.c:59
msgctxt "guida-esempi"
msgid ""
"rspeak remind 12¦Asks again, right now, whoever has not confirmed message 12."
msgstr ""
"rspeak remind 12¦Richiede subito la conferma a chi non ha ancora confermato "
"il messaggio 12."

#: src/guida.c:63
msgctxt "guida-file"
msgid ""
"/etc/rootspeak/rootspeak.conf¦Configuration: minutes before a postponed "
"message is asked about again, check interval of the desktop agent."
msgstr ""
"/etc/rootspeak/rootspeak.conf¦Configurazione: minuti prima di riproporre un "
"messaggio rimandato, intervallo di controllo dell'agente del desktop."

#: src/guida.c:64
msgctxt "guida-file"
msgid ""
"/var/lib/rootspeak/¦The messages: sent/ (reference copies, root only) and "
"users/USER/ (each user's mailbox, readable only by them and by root)."
msgstr ""
"/var/lib/rootspeak/¦I messaggi: sent/ (copie di riferimento, solo root) e "
"users/UTENTE/ (la casella di ogni utente, leggibile solo da lui e da root)."

#: src/guida.c:65
msgctxt "guida-file"
msgid ""
"sudo journalctl -t rspeak¦The system log: sending, deliveries, confirmations "
"and revocations."
msgstr ""
"sudo journalctl -t rspeak¦Il registro di sistema: invii, consegne, conferme "
"e ritiri."

#: src/guida.c:66
msgctxt "guida-file"
msgid ""
"/usr/local/share/doc/rootspeak/User Manual.html¦The complete user manual, to "
"open in a browser."
msgstr ""
"/usr/local/share/doc/rootspeak/User Manual.html¦Il manuale utente completo "
"(in inglese), da aprire in un browser."

